package aviation
public
	with base_types;
	with composite_nodes;
		
	system Supervised_System
		features
			timeToFailure: out data port real;
			timeToRecovery: out data port real;
			
			p1: out data port bool;
			p2: out data port bool;
			p3: out data port bool;
	end Supervised_System;
	
	system implementation Supervised_System.impl
		subcomponents
			gcas: system GCAS_singleton;
			tcas: system TCAS_singleton;
			geof: system GeoFence_singleton;
			
			supervisor: system Supervisor;
		
		connections
			gcas_ttr: port gcas.timeToRecovery -> supervisor.gcas_timeToRecovery;
			tcas_ttr: port tcas.timeToRecovery -> supervisor.tcas_timeToRecovery;
			geof_ttr: port geof.timeToRecovery -> supervisor.geof_timeToRecovery;
			
			gcas_ttf: port gcas.timeToFailure -> supervisor.gcas_timeToFailure;
			tcas_ttf: port tcas.timeToFailure -> supervisor.tcas_timeToFailure;
			geof_ttf: port geof.timeToFailure -> supervisor.geof_timeToFailure;
			
			ttf_to_top: port supervisor.timeToFailure -> timeToFailure;
			ttr_to_top: port supervisor.timeToRecovery -> timeToRecovery;
			
			p1_port: port supervisor.p1 -> p1;
			p2_port: port supervisor.p2 -> p2;
			p3_port: port supervisor.p3 -> p3;
	end Supervised_System.impl;
	
	system GeoFence_singleton
		features
			timeToRecovery: out data port real;
			timeToFailure: out data port real;
	end GeoFence_singleton;
	
	system implementation GeoFence_singleton.impl
		annex agree {** **};
	end GeoFence_singleton.impl;
	
	system TCAS_singleton
		features
			nearestIntruderAltitude: in data port int;
			nearestIntruderGroundDistance: in data port int;
			nearestIntruderLongitude: in data port int;
			ownAltitude_in: in data port int;
			ownHeading: in data port int;
			ownVerticalVelocity: in data port int;
			ownLatitude: in data port int;
			ownLongitude: in data port int;
			
			requiredVerticalVelocity: out data port int;
			timeToRecovery: out data port real;
			timeToFailure: out data port real;
	end TCAS_singleton;

	system implementation TCAS_singleton.impl
		annex agree {** **};
	end TCAS_singleton.impl;
	
	system GCAS_singleton
		features
			altitude: in data port real;
			timeToRecovery: out data port real;
			timeToFailure: out data port real;
	end GCAS_singleton;
	
	system implementation GCAS_singleton.impl
		annex agree {** **};
	end GCAS_singleton.impl;
	
	system Supervisor
		features
			gcas_timeToFailure: in data port real;
			tcas_timeToFailure: in data port real;
			geof_timeToFailure: in data port real;
			
			timeToFailure: out data port real;
			
			gcas_timeToRecovery: in data port real;
			tcas_timeToRecovery: in data port real;
			geof_timeToRecovery: in data port real;
			
			timeToRecovery: out data port real;
			p1: out data port bool;
			p2: out data port bool;
			p3: out data port bool;
		
		annex agree {**
			eq min_ttf : real;
			eq concurrency_res_1 : bool;
			eq concurrency_res_2 : bool;
			eq concurrency_res_3 : bool;
			
			guarantee "ttf is min of subs": timeToFailure = min_ttf;
			guarantee "p1 is first concurrency result": p1 = concurrency_res_1;
			guarantee "p2 is second concurrency result": p2 = concurrency_res_2;
			guarantee "p3 is third concurrency result": p3 = concurrency_res_3;
			guarantee "ttf greater than sum of ttrs": timeToFailure > gcas_timeToRecovery + tcas_timeToRecovery + geof_timeToRecovery;
		**};
	end Supervisor;
	
	system implementation Supervisor.impl
		annex agree {**
			assign min_ttf = 
				if gcas_timeToFailure <= tcas_timeToFailure then
					if gcas_timeToFailure <= geof_timeToFailure then
						gcas_timeToFailure
					else
						geof_timeToFailure
				else
					if tcas_timeToFailure <= geof_timeToFailure then
						tcas_timeToFailure
					else
						geof_timeToFailure;
			assign concurrency_res_1 = composite_nodes::concurrencyFactor(gcas_timeToRecovery, min_ttf, 1.0, 1.0);
			assign concurrency_res_2 = composite_nodes::concurrencyFactor(tcas_timeToRecovery, min_ttf, 1.0, 1.0);
			assign concurrency_res_3 = composite_nodes::concurrencyFactor(geof_timeToRecovery, min_ttf, 1.0, 1.0);
		**};
	end Supervisor.impl;
	
	-- Type Aliases
	
	data int extends base_types::Integer
	end int;
	
	data real extends base_types::Float
	end real;
	
	data bool extends base_types::Boolean
	end bool;
	
end aviation;