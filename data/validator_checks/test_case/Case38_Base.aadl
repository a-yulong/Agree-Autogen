package Types
	with Base_Types;
public

	data real extends Base_Types::Float
	end real;

	data int extends Base_Types::Integer
	end int;

	data bool extends Base_Types::Boolean
	end bool;

	data speed
	end speed;

	data implementation speed.speed_impl
	subcomponents
		val: data real;
	end speed.speed_impl;

	data state_sig
	end state_sig;

	data implementation state_sig.impl
	subcomponents
		val: data int;
	end state_sig.impl;
end Types;

package Transmission
	with Base_Types;
	with Types;
public

	system Speed_Control
		features
			Target: in data port Types::speed;
			Actuator_Input: out data port Types::real;
			Actual: in data port Types::speed;
	end Speed_Control;

	system implementation Speed_Control.Speed_Control_Impl
		annex agree {**
		**};
	end Speed_Control.Speed_Control_Impl;

	system Throttle
		features
			Actuator_Input: in data port Types::real;
			Actual: out data port Types::real;
		
		annex agree {**
			eq t : Types::real = 0.0 -> pre(t) + 1.0;
			eq actuator_in_real : Types::real;
			eq actual_val : Types::real = 0.0 -> pre(actual_val) + 0.1 * actuator_in_real;
			
			guarantee "G2_actual_output": Actual = actual_val;
		**};
	end Throttle;

	system implementation Throttle.Throttle_Impl
		annex agree {**
			assign actuator_in_real = Actuator_Input;
		**};
	end Throttle.Throttle_Impl;

	system Sub_State_Machine
		features
			State_Out: out data port Types::int;
	end Sub_State_Machine;

	system implementation Sub_State_Machine.Impl
		annex agree {**
		**};
	end Sub_State_Machine.Impl;

	system State_Machine
		features
			State_Out: out data port Types::int;
	end State_Machine;

	system implementation State_Machine.Impl
		subcomponents
			SSM: system Sub_State_Machine.Impl;

		connections
			SMToSSM: port SSM.State_Out -> State_Out;
		end connections;
		
		annex agree {**
		**};
	end State_Machine.Impl;

end Transmission;